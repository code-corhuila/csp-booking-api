# Names and placeholders only: never a real value. Copy to .env for local runs.
# Every variable the service reads is listed here; the Pull Requests that add configuration add their names.
PORT=8083
# Public key of the identity service that validates every token (Norma 5.3.7).
# Set one of the two, not both: the PEM itself, or the path of the file that holds it.
JWT_PUBLIC_KEY=change-me
JWT_PUBLIC_KEY_FILE=change-me
# Database of this domain (Annex J.5). The pool, the wait for a connection and the statement
# timeout are declared in booking-app/src/main/resources/application.yml (Norma 5.3.10).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/csp
SPRING_DATASOURCE_USERNAME=booking_app
SPRING_DATASOURCE_PASSWORD=change-me
# Base of the Catalog API inside the platform network and the file with the service credential Booking presents to it (ADR-020).
# Without CATALOG_BASE_URL the routes that need Catalog answer 503; with it, the token file is required.
CATALOG_BASE_URL=http://localhost:8082/api/v1/catalog
CATALOG_SERVICE_TOKEN_FILE=change-me
# Subjects (sub) of the service tokens allowed on the internal operations, comma separated (ADR-020).
SERVICE_SUBJECTS=csp-worker
# Subjects (sub) of the service tokens allowed on /internal/workflow/, comma separated (ADR-035). Empty keeps those operations closed.
WORKFLOW_SUBJECTS=
