# Names and placeholders only: never a real value. Copy to .env for local runs.
# Every variable the service reads is listed here; the Pull Requests that add configuration add their names.
PORT=8083
# Public key of the identity service that validates every token (Norma 5.3.7).
# Set one of the two, not both: the PEM itself, or the path of the file that holds it.
JWT_PUBLIC_KEY=change-me
JWT_PUBLIC_KEY_FILE=change-me
